{
  "redirects": [
    { "source": "/convert_frames.html", "destination": "/pages/convert_gif.html", "permanent": true },
    { "source": "/convert_images_rgb.html", "destination": "/pages/convert_images_rgb.html", "permanent": true },
    { "source": "/view_pin.html", "destination": "/pages/view_pin.html", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ]
}
